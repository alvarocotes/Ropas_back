PORT=3000

# La API acepta peticiones desde cualquier origen, no hay que configurar la URL del frontend.

# mysql (servidor local o remoto) o sqlite (pruebas locales sin servidor)
DB_TYPE=mysql

# Para un servidor remoto usa el host que te dé el proveedor, p. ej. srvXXX.hstgr.io
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=abrigar

# true crea y ajusta las tablas al arrancar. Útil en desarrollo; en producción
# déjalo en false, porque revisar el esquema añade varios segundos al arranque.
DB_SYNC=true

JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRES_IN=8h

ADMIN_EMAIL=admin@abrigar.local
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=Administrador Entretejidos

# true crea el administrador inicial y los textos de "Quiénes somos" al arrancar.
# En producción actívalo una vez y vuelve a ponerlo en false: cada arranque en
# frío haría esas consultas antes de responder.
SEED_ON_START=true
